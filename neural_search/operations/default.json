
{
  "name": "delete-ingest-pipeline",
  "operation-type": "delete-pipeline",
  "id": "{{default_ingest_pipeline | default('nlp-default-ingest-pipeline')}}"
},
{
  "name": "put-cluster-settings",
  "operation-type": "put-settings",
  "body": {
    "persistent": {
      "plugins.ml_commons.only_run_on_ml_node": "{{ only_run_on_ml_node | default('false') }}",
      "plugins.ml_commons.native_memory_threshold": "{{ native_memory_threshold | default('99') }}",
      "plugins.ml_commons.allow_registering_model_via_url": "{{ allow_registering_model_via_url | default('true') }}",
      "plugins.ml_commons.trusted_connector_endpoints_regex": [
        "^https://bedrock-runtime\\..*[a-z0-9-]\\.amazonaws\\.com/.*$"
      ]
    }
  }
},
{
  "name": "put-concurrent-segment-search-setting",
  "operation-type": "put-settings",
  "body": {
    "transient": {
        "search.concurrent_segment_search.enabled": "{{concurrent_segment_search_enabled}}"
    }
  }
},
{
  "name": "index-append",
  "operation-type": "bulk",
  "indices": ["{{ index_name }}"],
  "bulk-size": {{bulk_size | default(100)}},
  "ingest-percentage": {{ingest_percentage | default(100)}},
  {%- if index_target_throughput is defined and index_target_throughput  %}
  "target-throughput": {{ index_target_throughput | tojson }},
  {%- endif %}
  "corpora": "{{ corpora_name }}"
},
{
  "name": "wait-until-merges-finish",
  "operation-type": "index-stats",
  "index": "_all",
  "condition": {
    "path": "_all.total.merges.current",
    "expected-value": 0
  },
  "retry-until-success": true,
  "include-in-reporting": false
},
{
  "name": "match-all",
  "operation-type": "search",
  "index": "{{ index_name }}",
  "body": {
    "query": {
      "match_all": {}
    }
  }
},

{
  "name": "create-text-embedding-processor-ingest-pipeline",
  "operation-type": "put-pipeline",
  "param-source": "create-ingest-pipeline-source",
  "id": "{{default_ingest_pipeline | default('nlp-default-ingest-pipeline')}}",
  "body": {
    "description": "An NLP ingest pipeline for dense embedding",
    "processors": [
        {%- if nested is defined and nested == true  %}
          {
            "text_chunking": {
              "algorithm": {
                "fixed_token_length": {}
              },
              "field_map": {
                "text": "passage_chunk"
              }
            }
          },
          {
            "text_embedding": {
              "model_id": "",
              "field_map": {
                "passage_chunk": "passage_chunk_embedding"
              }
            }
          }
      {% else %}
        {
          "text_embedding": {
            "model_id": "",
            "field_map": {
              "text": "passage_embedding"
            }
          }
        }
      {% endif %}
    ]
  }
},
{
  "name": "register-ml-model-sentence-transformer",
  "operation-type": "register-ml-model",
  "model-name": "{{ model_name | default('huggingface/sentence-transformers/all-MiniLM-L6-v2')}}",
  "model-version": "{{ model_version | default('1.0.1') }}",
  "model-format": "{{ model_format | default('TORCH_SCRIPT') }}",
  "model-config-file": "{{ model_config_file | default('') }}"
},
{
  "name": "delete-ml-model-sentence-transformer",
  "operation-type": "delete-ml-model",
  "model-name": "{{ model_name | default('huggingface/sentence-transformers/all-MiniLM-L6-v2')}}"
},
{
  "name": "register-ml-model-reranker",
  "operation-type": "register-ml-model",
  "model-name": "{{ reranker_model_name | default('huggingface/cross-encoder/ms-marco-MiniLM-L-6-v2') }}",
  "model-version": "{{ reranker_model_version | default('1.0.1') }}",
  "model-format": "{{ reranker_model_format | default('TORCH_SCRIPT') }}",
  "model-config-file": "{{ reranker_model_config_file | default('') }}"
},
{
  "name": "delete-ml-model-reranker",
  "operation-type": "delete-ml-model",
  "model-name": "{{ reranker_model_name | default('huggingface/cross-encoder/ms-marco-MiniLM-L-6-v2') }}"
},
{
  "name": "save-embedding-model-id",
  "operation-type": "save-model-id",
  "target": "embedding_model_id.json"
},
{
  "name": "save-reranker-model-id",
  "operation-type": "save-model-id",
  "target": "reranker_model_id.json"
},
{
  "name": "create-rerank-search-pipeline",
  "operation-type": "create-search-pipeline",
  "param-source": "create-rerank-search-pipeline-source",
  "id": "{{ rerank_search_pipeline_id | default('rerank-search-pipeline') }}",
  "body": {
    "description": "Cross-encoder re-ranking search pipeline",
    "response_processors": [
      {
        "rerank": {
          "ml_opensearch": {
            "model_id": ""
          },
          "context": {
            "document_fields": [
              "text"
            ]
          }
        }
      }
    ]
  }
},
{
  "name": "delete-rerank-search-pipeline",
  "operation-type": "delete-pipeline",
  "id": "{{ rerank_search_pipeline_id | default('rerank-search-pipeline') }}"
}
