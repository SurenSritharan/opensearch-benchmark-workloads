    },
    {%- endif %}
    {%- if reranker_model_id is not defined %}
    {
      "operation": "delete-ml-model-reranker"
    },
    {%- endif %}
    {
      "operation": "put-cluster-settings"
    },
    {%- if embedding_model_id is defined %}
    {
      "operation": "set-embedding-model-id-from-param"
    },
    {%- else %}
    {
      "operation": "register-ml-model-sentence-transformer"
    },
    {
      "name": "deploy-embedding-model",
      "operation": "deploy-ml-model"
    },
    {
      "operation": "save-embedding-model-id"
    },
    {%- endif %}
    {
      "operation": "create-text-embedding-processor-ingest-pipeline"
    },
    {%- if reranker_model_id is defined %}
    {
      "operation": "set-reranker-model-id-from-param"
    },
    {%- else %}
    {
      "operation": "register-ml-model-reranker"
    },
    {
      "name": "deploy-reranker-model",
      "operation": "deploy-ml-model"
    },
    {
      "operation": "save-reranker-model-id"
    },
    {%- endif %}
    {
      "operation": "create-rerank-search-pipeline"
    },
    {{ benchmark.collect(parts="common/create_index_and_ingest_document.json") }}
  ]
},
{
  "name": "semantic-search-with-reranker-query-only",
  "description": "Runs neural search queries with reranker pipeline, applicable when models, pipelines, and index already exist.",
  "default": false,
  "schedule": [
    {%- if concurrent_segment_search_enabled is defined %}
    {
      "operation": "put-concurrent-segment-search-setting"
    },
    {%- endif %}
    {
      "operation": "semantic-search-with-reranker",
      "warmup-iterations": {{warmup_iterations | default(100) | tojson}},
