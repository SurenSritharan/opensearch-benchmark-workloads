{
  "name": "semantic-search",
  "description": "Creates model and pipelines, indexes the corpus and then runs neural clause queries with Semantic search.",
  "default": false,
  "schedule": [
    {
      "operation": "delete-index"
    },
    {
      "operation": "delete-ingest-pipeline"
    },
    {%- if embedding_model_id is not defined %}
    {
      "operation": "delete-ml-model-sentence-transformer"
    },
    {%- endif %}
    {
      "operation": "put-cluster-settings"
    },
    {%- if concurrent_segment_search_enabled is defined %}
    {
      "operation": "put-concurrent-segment-search-setting"
    },
    {%- endif %}
    {%- if embedding_model_id is defined %}
    {
      "operation": "set-embedding-model-id-from-param"
    },
    {%- else %}
    {
      "operation": "register-ml-model-sentence-transformer"
    },
    {
      "name": "deploy-embedding-model",
      "operation": "deploy-ml-model"
    },
    {
      "operation": "save-embedding-model-id"
    },
    {%- endif %}
    {
      "operation": "create-text-embedding-processor-ingest-pipeline"
    },
    {{ benchmark.collect(parts="common/create_index_and_ingest_document.json") }},
    {{ benchmark.collect(parts="common/match_all_search.json") }},
    {
      "operation": "semantic-search",
      "warmup-iterations": {{warmup_iterations | default(100) | tojson}},
      "iterations": {{iterations | default(100) | tojson }},
      "target-throughput": {{ target_throughput | default(0) | tojson}},
      "clients": {{ search_clients | default(1)}}
    }
  ]
},
{
  "name": "semantic-search-create-resources-and-index-document",
  "description": "Create resourses (model, pipeline and index) for Semantic search, then ingest the corpus",
  "default": false,
  "schedule": [
    {
      "operation": "delete-index"
    },
    {
      "operation": "delete-ingest-pipeline"
    },
    {%- if embedding_model_id is not defined %}
    {
      "operation": "delete-ml-model-sentence-transformer"
    },
    {%- endif %}
    {
      "operation": "put-cluster-settings"
    },
    {%- if embedding_model_id is defined %}
    {
      "operation": "set-embedding-model-id-from-param"
    },
    {%- else %}
    {
      "operation": "register-ml-model-sentence-transformer"
    },
    {
      "name": "deploy-embedding-model",
      "operation": "deploy-ml-model"
    },
    {
      "operation": "save-embedding-model-id"
    },
    {%- endif %}
    {
      "operation": "create-text-embedding-processor-ingest-pipeline"
    },
    {{ benchmark.collect(parts="common/create_index_and_ingest_document.json") }}
  ]
},
{
  "name": "semantic-search-query-only",
  "description": "Runs neural clause queries with Semantic search, applicable only when pipelines, model and index are created, and corpus is ingested.",
  "default": false,
  "schedule": [
    {%- if concurrent_segment_search_enabled is defined %}
    {
      "operation": "put-concurrent-segment-search-setting"
    },
    {%- endif %}
    {
      "operation": "semantic-search",
      "warmup-iterations": {{warmup_iterations | default(100) | tojson}},
      "iterations": {{iterations | default(100) | tojson }},
      "target-throughput": {{ target_throughput | default(0) | tojson}},
      "clients": {{ search_clients | default(1)}}
    }
  ]
},
{
  "name": "semantic-search-with-reranker",
  "description": "Deploys embedding and re-ranker models, creates ingest and rerank search pipelines, indexes corpus, and runs semantic search with cross-encoder reranking.",
  "default": false,
  "schedule": [
    {
      "operation": "delete-index"
    },
    {
      "operation": "delete-ingest-pipeline"
    },
    {
      "operation": "delete-rerank-search-pipeline"
    },
    {%- if embedding_model_id is not defined %}
    {
      "operation": "delete-ml-model-sentence-transformer"
    },
    {%- endif %}
    {%- if reranker_model_id is not defined %}
    {
      "operation": "delete-ml-model-reranker"
    },
    {%- endif %}
    {
      "operation": "put-cluster-settings"
    },
    {%- if concurrent_segment_search_enabled is defined %}
    {
      "operation": "put-concurrent-segment-search-setting"
    },
    {%- endif %}
    {%- if embedding_model_id is defined %}
    {
      "operation": "set-embedding-model-id-from-param"
    },
    {%- else %}
    {
      "operation": "register-ml-model-sentence-transformer"
    },
    {
      "name": "deploy-embedding-model",
      "operation": "deploy-ml-model"
    },
    {
      "operation": "save-embedding-model-id"
    },
    {%- endif %}
    {
      "operation": "create-text-embedding-processor-ingest-pipeline"
    },
    {%- if reranker_model_id is defined %}
    {
      "operation": "set-reranker-model-id-from-param"
    },
    {%- else %}
    {
      "operation": "register-ml-model-reranker"
    },
    {
      "name": "deploy-reranker-model",
      "operation": "deploy-ml-model"
    },
    {
      "operation": "save-reranker-model-id"
    },
    {%- endif %}
    {
      "operation": "create-rerank-search-pipeline"
    },
    {{ benchmark.collect(parts="common/create_index_and_ingest_document.json") }},
    {{ benchmark.collect(parts="common/match_all_search.json") }},
    {
      "operation": "semantic-search-with-reranker",
      "warmup-iterations": {{warmup_iterations | default(100) | tojson}},
      "iterations": {{iterations | default(100) | tojson }},
      "target-throughput": {{ target_throughput | default(0) | tojson}},
      "clients": {{ search_clients | default(1)}}
    }
  ]
},
{
  "name": "semantic-search-with-reranker-create-resources-and-index-document",
  "description": "Create resources (embedding model, reranker model, pipelines and index) for Semantic search with reranker, then ingest the corpus.",
  "default": false,
  "schedule": [
    {
      "operation": "delete-index"
    },
    {
      "operation": "delete-ingest-pipeline"
    },
    {
      "operation": "delete-rerank-search-pipeline"
    },
    {%- if embedding_model_id is not defined %}
    {
