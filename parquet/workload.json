{%- set _n = num_vectors | default(50000) | int -%}
{%- if _n >= 1000000 and _n % 1000000 == 0 -%}
  {%- set _count_label = (_n // 1000000) | string + 'm' -%}
{%- elif _n >= 1000 and _n % 1000 == 0 -%}
  {%- set _count_label = (_n // 1000) | string + 'k' -%}
{%- else -%}
  {%- set _count_label = _n | string -%}
{%- endif -%}
{%- set _default_index = 'parquet-vectors-' + _count_label -%}
{%- set _default_gt_file = 'parquet-vectors-gt-' + _count_label + '.json' -%}
{%- set _index = target_index_name | default(_default_index) -%}
{%- set _gt_file = queries_file | default(_default_gt_file) -%}
{#- Column mapping / real-query params shared by every parquet-bulk-reader task. -#}
{%- macro source_columns() -%}
{%- if id_column is defined %}"id_column": "{{ id_column }}",{% endif %}
{%- if text_column is defined %}"text_column": "{{ text_column }}",{% endif %}
{%- if title_column is defined %}"title_column": "{{ title_column }}",{% endif %}
{%- if extra_columns is defined %}"extra_columns": {{ extra_columns | tojson }},{% endif %}
{%- if derived_fields is defined %}"derived_fields": {{ derived_fields | tojson }},{% endif %}
{%- if include_pid is defined %}"include_pid": {{ include_pid | tojson }},{% endif %}
{%- if real_queries_file is defined %}"real_queries_file": "{{ real_queries_file }}",{% endif %}
{%- endmacro -%}
{#- Search params shared by every vector-search-reader task. -#}
{%- macro search_extras() -%}
{%- if filter_body is defined %}"filter_body": {{ filter_body | tojson }},{% endif %}
{%- if filter_mode is defined %}"filter_mode": "{{ filter_mode }}",{% endif %}
{%- if qrel_id_separator is defined %}"qrel_id_separator": "{{ qrel_id_separator }}",{% endif %}
{%- if ndcg_summary_file is defined %}"ndcg_summary_file": "{{ ndcg_summary_file }}",{% endif %}
{%- endmacro -%}
{
  "description": "Parquet Vector Benchmark Workload",
  "indices": [
    {
      "name": "{{ _index }}",
      "body": "{{ target_index_body | default('indices/index.json') }}"
    }
  ],
  "test_procedures": [
    {
      "name": "delete-index",
      "description": "Delete the index if it exists",
      "default": false,
      "schedule": [
        {
          "operation": {
            "operation-type": "delete-index",
            "only-if-exists": true,
            "index": "{{ _index }}"
          }
        }
      ]
    },
    {
      "name": "create-index",
      "description": "Create the index without loading data",
      "default": false,
      "schedule": [
        {
          "operation": {
            "operation-type": "create-index",
            "index": "{{ _index }}"
          }
        }
      ]
    },
    {
      "name": "bulk-ingest-data",
      "description": "Stream Parquet files from HuggingFace and bulk-index into OpenSearch",
      "default": false,
      "schedule": [
        {
          "name": "bulk-ingest-parquet",
          "operation": {
            "operation-type": "bulk",
            "param-source": "parquet-bulk-reader",
            "index": "{{ _index }}",
            "target_vector_count": {{ _n }},
            "target_index_dimension": {{ target_index_dimension | default(1024) }},
            "target_field_name": "{{ target_field_name | default('emb') }}",
            "batch_size": {{ target_index_batch_size | default(5000) }},
            "bulk_size": {{ target_index_bulk_size | default(1000) }},
            "num_queries": {{ num_queries | default(10000) }},
            "queries_file": "{{ _gt_file }}",
            {%- if hf_repo_id is defined %}
            "hf_repo_id": "{{ hf_repo_id }}",
            {%- endif %}
            {%- if hf_dataset_dir is defined %}
            "hf_dataset_dir": "{{ hf_dataset_dir }}",
            {%- endif %}
            {{ source_columns() }}
            "detailed-results": {{ detailed_results | default(false) | tojson }}
          },
          "clients": {{ target_index_bulk_indexing_clients | default(1) }}
        },
        {
          "operation": {
            "operation-type": "refresh",
            "index": "{{ _index }}",
            "request-timeout": 7200
          }
        }
      ]
    },
    {
      "name": "bulk-ingest-and-search",
      "description": "Run bulk-ingest and vector search concurrently",
      "default": false,
      "schedule": [
        {
          "parallel": {
            "clients": {{ (target_index_bulk_indexing_clients | default(1)) + (search_clients | default(1)) }},
            "tasks": [
              {
                "name": "bulk-ingest-parquet",
                "operation": {
                  "operation-type": "bulk",
                  "param-source": "parquet-bulk-reader",
                  "index": "{{ _index }}",
                  "target_vector_count": {{ _n }},
                  "target_index_dimension": {{ target_index_dimension | default(1024) }},
                  "target_field_name": "{{ target_field_name | default('emb') }}",
                  "batch_size": {{ target_index_batch_size | default(5000) }},
                  "bulk_size": {{ target_index_bulk_size | default(1000) }},
                  "num_queries": {{ num_queries | default(10000) }},
                  "queries_file": "{{ _gt_file }}",
                  {%- if hf_repo_id is defined %}
                  "hf_repo_id": "{{ hf_repo_id }}",
                  {%- endif %}
                  {%- if hf_dataset_dir is defined %}
                  "hf_dataset_dir": "{{ hf_dataset_dir }}",
                  {%- endif %}
                  {{ source_columns() }}
                  "detailed-results": {{ detailed_results | default(false) | tojson }}
                },
                "clients": {{ target_index_bulk_indexing_clients | default(1) }}
              },
              {
                "name": "vector-search-queries",
                "operation": {
                  "operation-type": "vector-search-ndcg",
                  "param-source": "vector-search-reader",
                  {{ search_extras() }}
                  "index": "{{ _index }}",
                  "target_vector_count": {{ _n }},
                  "target_field_name": "{{ target_field_name | default('emb') }}",
                  "queries_file": "{{ _gt_file }}",
                  "k": {{ query_k | default(10) }},
                  "ef_search": {{ ef_search | default(64) }},
                  "detailed-results": true
                },
                "clients": {{ search_clients | default(1) }},
                {% if time_period is defined %}
                "warmup-time-period": {{ warmup_time_period | default(60) }},
                "time-period": {{ time_period }}
                {% else %}
                "warmup-iterations": {{ warmup_iterations | default(0) }},
                "iterations": {{ iterations | default(1000) }}
                {% endif %}
              }
            ]
          }
        }
      ]
    },
    {
      "name": "force-merge",
      "description": "Force merge the index to the specified number of segments",
      "default": false,
      "schedule": [
        {
          "operation": {
            "operation-type": "force-merge",
            "index": "{{ _index }}",
            "request-timeout": {{ target_index_force_merge_timeout | default(28800) }},
            "mode": "polling",
            "max-num-segments": {{ target_index_max_num_segments | default(1) }},
            "include-in-results_publishing": true
          }
        },
        {
          "operation": {
            "operation-type": "refresh",
            "index": "{{ _index }}",
            "request-timeout": 7200
          }
        }
      ]
    },
    {
      "name": "refresh-index",
      "description": "Refresh the index",
      "default": false,
      "schedule": [
        {
          "operation": {
            "operation-type": "refresh",
            "index": "{{ _index }}",
            "request-timeout": 7200
          }
        }
      ]
    },
    {
      "name": "update-index-settings",
      "description": "Update settings for the existing index",
      "default": false,
      "schedule": [
        {
          "operation": {
            "operation-type": "raw-request",
            "method": "PUT",
            "path": "/{{ _index }}/_settings",
            "body": {{ index_settings | default({}) | tojson }}
          }
        }
      ]
    },
    {
      "name": "vector-search",
      "description": "Run k-NN vector search with ground-truth recall evaluation",
      "default": true,
      "schedule": [
        {
          "name": "vector-search-queries",
          "operation": {
            "operation-type": "vector-search-ndcg",
            "param-source": "vector-search-reader",
            {{ search_extras() }}
            "index": "{{ _index }}",
            "target_vector_count": {{ _n }},
            "target_field_name": "{{ target_field_name | default('emb') }}",
            "queries_file": "{{ _gt_file }}",
            "k": {{ query_k | default(10) }},
            "ef_search": {{ ef_search | default(64) }},
            "detailed-results": true
          },
          "clients": {{ search_clients | default(1) }},
          {% if time_period is defined %}
          "warmup-time-period": {{ warmup_time_period | default(60) }},
          "time-period": {{ time_period }}
          {% else %}
          "warmup-iterations": {{ warmup_iterations | default(0) }},
          "iterations": {{ iterations | default(1000) }}
          {% endif %}
        }
      ]
    },
    {
      "name": "create-search-pipeline",
      "description": "Create the normalization-processor search pipeline required for hybrid search",
      "default": false,
      "schedule": [
        {
          "operation": {
            "operation-type": "raw-request",
            "method": "PUT",
            "path": "/_search/pipeline/{{ search_pipeline | default('hybrid-search-pipeline') }}",
            "body": {
              "description": "Hybrid search normalization pipeline",
              "phase_results_processors": [
                {
                  "normalization-processor": {
                    "normalization": {
                      "technique": "{{ normalization_technique | default('min_max') }}"
                    },
                    "combination": {
                      "technique": "arithmetic_mean",
                      "parameters": {
                        "weights": [
                          {{ bm25_weight | default(0.3) }},
                          {{ knn_weight  | default(0.7) }}
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "delete-search-pipeline",
      "description": "Delete the hybrid search pipeline",
      "default": false,
      "schedule": [
        {
          "operation": {
            "operation-type": "raw-request",
            "method": "DELETE",
            "path": "/_search/pipeline/{{ search_pipeline | default('hybrid-search-pipeline') }}"
          }
        }
      ]
    },
    {
      "name": "hybrid-search",
      "description": "Run hybrid BM25+kNN search via a normalization-processor pipeline. Ground truth is exact FAISS kNN neighbors — recall measures agreement with pure vector ranking.",
      "default": false,
      "schedule": [
        {
          "name": "hybrid-search-queries",
          "operation": {
            "operation-type": "vector-search-ndcg",
            "param-source": "vector-search-reader",
            {{ search_extras() }}
            "index": "{{ _index }}",
            "target_vector_count": {{ _n }},
            "target_field_name": "{{ target_field_name | default('emb') }}",
            "queries_file": "{{ _gt_file }}",
            "k": {{ query_k | default(10) }},
            "ef_search": {{ ef_search | default(64) }},
            "search_mode": "hybrid",
            "search_pipeline": "{{ search_pipeline | default('hybrid-search-pipeline') }}",
            "hybrid_text_field": "{{ hybrid_text_field | default('text') }}",
            "detailed-results": true
          },
          "clients": {{ search_clients | default(1) }},
          {% if time_period is defined %}
          "warmup-time-period": {{ warmup_time_period | default(60) }},
          "time-period": {{ time_period }}
          {% else %}
          "warmup-iterations": {{ warmup_iterations | default(0) }},
          "iterations": {{ iterations | default(1000) }}
          {% endif %}
        }
      ]
    },
    {
      "name": "bm25-search",
      "description": "BM25 only (multi_match on title + text): the keyword leg of hybrid on its own",
      "default": false,
      "schedule": [
        {
          "name": "bm25-search-queries",
          "operation": {
            "operation-type": "vector-search-ndcg",
            "param-source": "vector-search-reader",
            {{ search_extras() }}
            "index": "{{ _index }}",
            "target_vector_count": {{ _n }},
            "target_field_name": "{{ target_field_name | default('emb') }}",
            "queries_file": "{{ _gt_file }}",
            "k": {{ query_k | default(10) }},
            "ef_search": {{ ef_search | default(64) }},
            "search_mode": "bm25",
            "hybrid_text_field": "{{ hybrid_text_field | default('text') }}",
            "detailed-results": true
          },
          "clients": {{ search_clients | default(1) }},
          {% if time_period is defined %}
          "warmup-time-period": {{ warmup_time_period | default(60) }},
          "time-period": {{ time_period }}
          {% else %}
          "warmup-iterations": {{ warmup_iterations | default(0) }},
          "iterations": {{ iterations | default(1000) }}
          {% endif %}
        }
      ]
    },
    {
      "name": "openrag-hybrid-search",
      "description": "OpenRAG retrieval query: bool/should of dis_max(knn)^0.7 + fuzzy multi_match^0.3 + match_phrase_prefix^0.25, raw scores, no search pipeline",
      "default": false,
      "schedule": [
        {
          "name": "openrag-hybrid-search-queries",
          "operation": {
            "operation-type": "vector-search-ndcg",
            "param-source": "vector-search-reader",
            {{ search_extras() }}
            "index": "{{ _index }}",
            "target_vector_count": {{ _n }},
            "target_field_name": "{{ target_field_name | default('emb') }}",
            "queries_file": "{{ _gt_file }}",
            "k": {{ query_k | default(10) }},
            "ef_search": {{ ef_search | default(64) }},
            "search_mode": "openrag-hybrid",
            "hybrid_text_field": "{{ hybrid_text_field | default('text') }}",
            "detailed-results": true
          },
          "clients": {{ search_clients | default(1) }},
          {% if time_period is defined %}
          "warmup-time-period": {{ warmup_time_period | default(60) }},
          "time-period": {{ time_period }}
          {% else %}
          "warmup-iterations": {{ warmup_iterations | default(0) }},
          "iterations": {{ iterations | default(1000) }}
          {% endif %}
        }
      ]
    }
  ]
}