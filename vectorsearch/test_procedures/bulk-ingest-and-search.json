{
  "name": "bulk-ingest-and-search",
  "description": "Seed index with seed_num_vectors docs and refresh, then concurrently ingest the full corpus while searching the seed data. Search recall is measured against the seed ground truth only — concurrent ingest docs are expected to slightly lower recall, measuring ingest impact on search quality. Search runs for exactly the ingest duration via completes-parent.",
  "default": false,
  "schedule": [
    {
      "name": "initial-ingest",
      "operation": {
        "name": "seed-ingest",
        "operation-type": "bulk-vector-data-set",
        "index": "{{ target_index_name | default('target_index') }}",
        "field": "{{ target_field_name | default('target_field') }}",
        "bulk_size": {{ target_index_bulk_size | default(500) }},
        "data_set_format": "{{ target_index_bulk_index_data_set_format | default('hdf5') }}",
        "data_set_path": "{{ target_index_bulk_index_data_set_path }}",
        "data_set_corpus": "{{ target_index_bulk_index_data_set_corpus }}",
        "num_vectors": {{ seed_num_vectors | default(100000) }},
        "id-field-name": "{{ id_field_name }}",
        "filter_attributes": {{ target_dataset_filter_attributes | default([]) | tojson }},
        "detailed-results": {{ detailed_results | default(false) | tojson }},
        "request-timeout": {{ bulk_request_timeout | default(600) }},
        "retries": {{ bulk_retries | default(3) }}
      },
      "clients": {{ target_index_bulk_indexing_clients | default(8) }}
    },
    {
      "name": "initial-refresh",
      "operation": {
        "operation-type": "refresh",
        "index": "{{ target_index_name | default('target_index') }}",
        "request-timeout": 7200
      }
    },
    {
      "parallel": {
        "clients": {{ (target_index_bulk_indexing_clients | default(8)) + (search_clients | default(1)) }},
        "tasks": [
          {
            "name": "concurrent-ingest",
            "completes-parent": true,
            "operation": {
              "operation-type": "bulk-vector-data-set",
              "index": "{{ target_index_name | default('target_index') }}",
              "field": "{{ target_field_name | default('target_field') }}",
              "bulk_size": {{ target_index_bulk_size | default(500) }},
              "data_set_format": "{{ target_index_bulk_index_data_set_format | default('hdf5') }}",
              "data_set_path": "{{ target_index_bulk_index_data_set_path }}",
              "data_set_corpus": "{{ target_index_bulk_index_data_set_corpus }}",
              "num_vectors": {{ target_index_num_vectors | default(-1) }},
              "id-field-name": "{{ id_field_name }}",
              "filter_attributes": {{ target_dataset_filter_attributes | default([]) | tojson }},
              "detailed-results": {{ detailed_results | default(false) | tojson }},
              "request-timeout": {{ bulk_request_timeout | default(600) }},
              "retries": {{ bulk_retries | default(3) }}
            },
            "clients": {{ target_index_bulk_indexing_clients | default(8) }}
          },
          {
            "name": "concurrent-search",
            "operation": {
              "name": "prod-queries",
              "operation-type": "vector-search",
              "index": "{{ target_index_name | default('target_index') }}",
              "detailed-results": true,
              {% if query_k is defined %}
              "k": {{ query_k }},
              {% endif %}
              "field": "{{ target_field_name | default('target_field') }}",
              "data_set_format": "{{ query_data_set_format | default('hdf5') }}",
              "data_set_corpus": "{{ query_data_set_corpus }}",
              "neighbors_data_set_corpus": "{{ neighbors_data_set_corpus }}",
              "neighbors_data_set_format": "{{ neighbors_data_set_format | default('hdf5') }}",
              "num_vectors": {{ query_count | default(-1) }},
              "id-field-name": "{{ id_field_name }}",
              "body": {{ query_body | default({}) | tojson }},
              "filter_body": {{ filter_body | default({}) | tojson }},
              "filter_type": {{ filter_type | default({}) | tojson }},
              "repetitions": {{ number_of_repetitions | default(1) }}
            },
            "clients": {{ search_clients | default(1) }},
            "warmup-iterations": 0,
            "iterations": 1000000
          }
        ]
      }
    },
    {
      "name": "post-refresh",
      "operation": {
        "operation-type": "refresh",
        "index": "{{ target_index_name | default('target_index') }}",
        "request-timeout": 7200
      }
    }
  ]
}
